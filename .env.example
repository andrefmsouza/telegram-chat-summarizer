# ── Telegram ─────────────────────────────────────────────────────────────
# Create an app at https://my.telegram.org/apps to get these two values
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Filled in by `npm run login`. It gives FULL access to your Telegram
# account: never share it, paste it in chats or commit it.
TELEGRAM_SESSION=

# Group or channel to read: numeric ID (e.g. -1001234567890) or @username
TELEGRAM_CHAT=
# Forum topic ID. Leave empty for groups without topics.
TELEGRAM_TOPIC_ID=

# ── Summary ──────────────────────────────────────────────────────────────
# "openai" = any OpenAI-compatible API (LM Studio, Ollama, OpenAI, OpenRouter...)
# "claude-code" = Claude Code in headless mode, using your Claude login
SUMMARY_PROVIDER=openai
SUMMARY_LANGUAGE=Brazilian Portuguese

# ── OpenAI-compatible provider ───────────────────────────────────────────
# LM Studio: http://localhost:1234/v1
# Ollama:    http://localhost:11434/v1
# OpenAI:    https://api.openai.com/v1
AI_BASE_URL=http://localhost:1234/v1
# Not needed for local servers
AI_API_KEY=
AI_MODEL=

# ── Claude Code provider ─────────────────────────────────────────────────
# Path to the `claude` executable, if it is not on your PATH
CLAUDE_CODE_PATH=claude
# Optional: sonnet, opus, haiku or a full model ID
CLAUDE_CODE_MODEL=
