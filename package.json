{
  "name": "telegram-chat-summarizer",
  "version": "1.0.0",
  "description": "Summarize a Telegram group or topic with the AI of your choice: a local model, any OpenAI-compatible API or Claude Code.",
  "author": "André Souza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrefmsouza/telegram-chat-summarizer.git"
  },
  "keywords": [
    "telegram",
    "summary",
    "llm",
    "openai",
    "lm-studio",
    "ollama",
    "claude-code"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tg-summarize": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "summarize": "tsx src/cli.ts",
    "login": "tsx src/login.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "openai": "^7.47.0",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
